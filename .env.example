APP_NAME=e-commerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_DOMAIN=justshop.test

# Local Development: Auto-add stores to /etc/hosts
# When true, newly created stores are automatically added to /etc/hosts in local environment
# ⚠️ This ONLY works in local environment with .test/.local/.localhost domains
# Production environments use wildcard DNS and MUST set this to false
APP_AUTO_UPDATE_HOSTS=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (Docker: service name is "db")
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=e-commerce
DB_USERNAME=
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis (Docker: service name is "redis"; predis needs no PHP extension)
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

# These three all ride on the same Redis instance above
SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis

SESSION_LIFETIME=86400
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=ecommerce_session

MEMCACHED_HOST=127.0.0.1

# Mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Storefront
STOREFRONT_BASE_DOMAIN=justshop.test
STOREFRONT_RUNTIME_ROLLOUT_MODE=full
STOREFRONT_RUNTIME_KILL_SWITCH=false
STOREFRONT_RUNTIME_INTERNAL_TENANT_KEYS=justshop-demo,demo.justshop.test
STOREFRONT_RUNTIME_PILOT_TENANT_KEYS=

# Storefront runtime cache TTLs (seconds)
STOREFRONT_RUNTIME_CACHE_TTL_ROUTE=300
STOREFRONT_RUNTIME_CACHE_TTL_PAGE=3600
STOREFRONT_RUNTIME_CACHE_TTL_NAVIGATION=1800
STOREFRONT_RUNTIME_CACHE_TTL_THEME=3600

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/users/auth/google/callback

# Billing Provider (options: stripe, test)
BILLING_PROVIDER=test

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_ECOMMERCE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=3.0
STRIPE_CONNECT_RETURN_BASE_URL=http://localhost:3000

# Frontend URL (CORS, redirects, email links)
FRONTEND_URL=http://laratenant.local:3001

# Sanctum Stateful Domains
# ⚠️ Must match the EXACT host:port your frontend runs on — Sanctum does a
# strict string comparison against the Origin/Referer header. "laratenant.local"
# does NOT cover "laratenant.local:3001" — you need both listed explicitly if
# both are ever used, or requests get "Session store not set on request."
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001,127.0.0.1,127.0.0.1:3000,127.0.0.1:3001,laratenant.local,laratenant.local:3001,demo.justshop.test,demo.justshop.test:3000

# Database Seeding
SEED_LARGE_DATASET=false
