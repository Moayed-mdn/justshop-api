APP_NAME=e-commerce
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_DOMAIN=justshop.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=e-commerce
DB_USERNAME=
DB_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3

# Queue Configuration
QUEUE_CONNECTION=redis

# Caching
CACHE_STORE=redis

# Redis Configuration
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Session Configuration
SESSION_DRIVER=redis

SESSION_LIFETIME=86400
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_COOKIE=ecommerce_session

MEMCACHED_HOST=127.0.0.1

# Mail
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_PRIVATE_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_HTTP_VERIFY_SSL=true

VITE_APP_NAME="${APP_NAME}"

# Storefront
STOREFRONT_BASE_DOMAIN=justshop.test

# Storefront runtime cache TTLs (seconds)
STOREFRONT_RUNTIME_CACHE_TTL_ROUTE=300
STOREFRONT_RUNTIME_CACHE_TTL_PAGE=3600
STOREFRONT_RUNTIME_CACHE_TTL_NAVIGATION=1800
STOREFRONT_RUNTIME_CACHE_TTL_THEME=3600

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/users/auth/google/callback

# Billing Provider (options: stripe, test)
BILLING_PROVIDER=stripe

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_ECOMMERCE_WEBHOOK_SECRET=

# Frontend URL (CORS, redirects, email links)
FRONTEND_URL=http://laratenant.local:3001

# Sanctum Stateful Domains
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001,127.0.0.1,127.0.0.1:3000,127.0.0.1:3001,laratenant.local,laratenant.local:3001,demo.justshop.test,demo.justshop.test:3000

# Firebase Cloud Messaging (Push Notifications)
# Provide either FIREBASE_CREDENTIALS_PATH (path to the service account JSON
# file on disk) or FIREBASE_CREDENTIALS_JSON (the JSON file contents,
# base64-encoded). Never commit the actual credentials file.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_HTTP_TIMEOUT=10

# Notification system
NOTIFICATIONS_QUEUE_CONNECTION=
NOTIFICATIONS_QUEUE=notifications
NOTIFICATIONS_FCM_MAX_TRIES=3
NOTIFICATIONS_FCM_BACKOFF_SECONDS=30
NOTIFICATIONS_HIGH_VALUE_ORDER_THRESHOLD=2000


# MinIO Configuration (S3-compatible local storage)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
